# Outils portables téléchargés (trop lourds pour Git)
Tools/*/python/
Tools/*/7zip/
Tools/*/tools.*

# Base de données
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm

# Logs
logs/*
!logs/.gitkeep

# Rapports générés
reports/*
!reports/.gitkeep

# État temporaire
temp/*
!temp/.gitkeep

# Configuration locale (à ne pas committer)
config/config.json
config/version.json

# Données à la racine (à côté de TakeOutBack/)
Incoming/
Archive/
!Incoming/.gitkeep
!Archive/.gitkeep

# Fichiers Python compilés
__pycache__/
*.pyc
*.pyo

# Système
.DS_Store
Thumbs.db
